# syntax=docker/dockerfile:1
#
# Inkling-2-Mini — TensorFold XPU (SergiioB/TensorFold @ b70-inkling2-mini-20261121 + Xe2 XMX/DP4A/Vision patches)
# Target: Intel Arc Pro B70 (BMG-G31 / Xe2) via Intel Level Zero
# Serves OpenAI-compatible API (text, reasoning, tools, vision) on port 8080.
#

FROM ubuntu:26.04 AS deps

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git xz-utils binutils \
    intel-ocloc libigc2 libigdfcl2 libigdgmm12 \
    && rm -rf /var/lib/apt/lists/*

# Install Zig 0.17.0 (verified sha256)
ARG ZIG_VERSION=0.17.0
ARG ZIG_SHA256=1cbe9df9f27e6b78d14ccbca43b6703a404ef79ef1c463de901d7f088d4e2026
RUN curl -fsSL "https://ziglang.org/download/${ZIG_VERSION}/zig-x86_64-linux-${ZIG_VERSION}.tar.xz" -o /tmp/zig.tar.xz && \
    echo "${ZIG_SHA256}  /tmp/zig.tar.xz" | sha256sum -c - && \
    mkdir -p /opt/zig && \
    tar -xf /tmp/zig.tar.xz -C /opt/zig --strip-components=1 && \
    rm /tmp/zig.tar.xz

# Fetch official tokenizer.json and chat_template.jinja (verified sha256)
ARG HF_REV=ed40e7da625f594fc9c4990f5f66be24873c22d7
RUN mkdir -p /app/meta && \
    curl -fsSL "https://huggingface.co/thinkingmachines/Inkling-2-Mini/resolve/${HF_REV}/tokenizer.json" -o /app/meta/tokenizer.json && \
    echo "7f332727f9a3f093dd452a39cc978e6757627e5dad1b0673aa4e75174f236dd6  /app/meta/tokenizer.json" | sha256sum -c - && \
    curl -fsSL "https://huggingface.co/thinkingmachines/Inkling-2-Mini/resolve/${HF_REV}/chat_template.jinja" -o /app/meta/chat_template.jinja && \
    echo "53a9035f3255945704b5857657cfb00c1165090c0641c4f782a0cbf268cc16dc  /app/meta/chat_template.jinja" | sha256sum -c -

# Clone pinned upstream TensorFold snapshot
ARG TF_TAG=b70-inkling2-mini-20261121
RUN git clone --depth 1 --branch "${TF_TAG}" https://github.com/SergiioB/TensorFold.git /app/tf

FROM deps AS builder

WORKDIR /app
COPY patches/ /tmp/patches/

# Apply local Xe2 XMX / DP4A / prefix-cache / vision patch series and build xpu-inkling2
RUN cd /app/tf && \
    git -c user.name="builder" -c user.email="builder@local" am /tmp/patches/*.patch && \
    /opt/zig/zig build xpu-inkling2 -Doptimize=ReleaseFast --prefix /app/out && \
    cp /app/tf/tools/xpu/inkling2_serve.py /app/inkling2_serve.py

FROM ubuntu:26.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/opt/venv/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates python3 python3-venv \
    libze1 libze-intel-gpu1 libigc2 libigdfcl2 \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir transformers tokenizers jinja2 pillow numpy

WORKDIR /app
COPY --from=deps /app/meta /app/meta
COPY --from=builder /app/out/bin/xpu-inkling2 /app/bin/xpu-inkling2
COPY --from=builder /app/inkling2_serve.py /app/inkling2_serve.py

EXPOSE 8080

ENTRYPOINT ["/opt/venv/bin/python3", "/app/inkling2_serve.py", "--runner", "/app/bin/xpu-inkling2", "--meta", "/app/meta"]
