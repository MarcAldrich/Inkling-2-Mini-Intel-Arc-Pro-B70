+fn mix64(x_: u64) u64 {
+    var x = x_ +% 0x9e3779b97f4a7c15;
+    x = (x ^ (x >> 30)) *% 0xbf58476d1ce4e5b9;
+    x = (x ^ (x >> 27)) *% 0x94d049bb133111eb;
+    return x ^ (x >> 31);
+}
+
+fn descLogit(logits: []const f32, a: u32, b: u32) bool {
+    const la = logits[a];
+    const lb = logits[b];
+    return if (la != lb) la > lb else a < b;
+}
+
+/// Exact f64 top_k / min_p / top_p sampler over softcapped logits, deterministic by (seed, pos).
+fn sampleFiltered(logits: []const f32, cand_buf: []u32, temp: f32, top_p: f32, top_k: u32, min_p: f32, seed: u64, pos: usize) u32 {
+    var max_l: f32 = -std.math.inf(f32);
+    var best_i: usize = 0;
+    for (logits, 0..) |l, i| {
+        if (l > max_l) {
+            max_l = l;
+            best_i = i;
+        }
+    }
+    if (!std.math.isFinite(max_l) or temp <= 0.0) return @intCast(best_i);
+    const inv_t: f64 = 1.0 / @as(f64, temp);
+    const min_l_tail: f32 = max_l - 22.0 * temp;
+    const min_l_p: f32 = if (min_p > 0.0) max_l + temp * @log(min_p) else min_l_tail;
+    const cutoff: f32 = @max(min_l_tail, min_l_p);
+    var n_cand: usize = 0;
+    for (logits, 0..) |l, i| {
+        if (l >= cutoff) {
+            cand_buf[n_cand] = @intCast(i);
+            n_cand += 1;
+        }
+    }
+    if (n_cand == 0) return @intCast(best_i);
+    var cands = cand_buf[0..n_cand];
+    std.mem.sort(u32, cands, logits, descLogit);
+    if (top_k > 0 and top_k < cands.len) cands = cands[0..top_k];
+    var total_w: f64 = 0.0;
+    for (cands) |id| total_w += @exp((@as(f64, logits[id]) - @as(f64, max_l)) * inv_t);
+    var kept_n: usize = 0;
+    var kept_w: f64 = 0.0;
+    const p_lim: f64 = @as(f64, top_p) * total_w;
+    for (cands, 0..) |id, j| {
+        kept_w += @exp((@as(f64, logits[id]) - @as(f64, max_l)) * inv_t);
+        kept_n = j + 1;
+        if (top_p < 1.0 and kept_w >= p_lim) break;
+    }
+    const h64 = mix64(seed ^ (@as(u64, pos) *% 0x9e3779b97f4a7c15));
+    // 52-bit exact f64 uniform in [2^-53, 1 - 2^-53]
+    const u: f64 = (@as(f64, @floatFromInt(h64 >> 12)) + 0.5) * (1.0 / 4503599627370496.0);
+    const target: f64 = u * kept_w;
+    var acc: f64 = 0.0;
+    for (cands[0..kept_n]) |id| {
+        acc += @exp((@as(f64, logits[id]) - @as(f64, max_l)) * inv_t);
+        if (acc >= target) return id;
+    }
+    return cands[kept_n - 1];
+}
