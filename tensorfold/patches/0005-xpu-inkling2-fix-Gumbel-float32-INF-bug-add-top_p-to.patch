+  // Zero <16-row KV tail padding so 16-row Xe2 2D block reads in ink2_attn_b_xmx never see uninitialized FP16 NaNs.
+  const int end_p = p0 + T;
+  const int pad_end = (end_p + 15) & ~15;
+  for (int pp_ = end_p; pp_ < pad_end; pp_++) {
