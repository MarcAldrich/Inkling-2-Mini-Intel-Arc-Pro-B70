+def load_image_bytes(part):
+    """Fetch raw image bytes from an OpenAI image_url / image / input_image content part."""
+    url = part.get("image_url") or part.get("image") or part.get("url")
+    if isinstance(url, dict):
+        url = url.get("url", "")
+    if not isinstance(url, str) or not url:
+        raise ValueError("missing image_url")
+    if url.startswith("data:"):
+        _, b64 = url.split(",", 1)
+        return base64.b64decode(b64)
+    if url.startswith(("http://", "https://")):
+        with urllib.request.urlopen(url, timeout=30) as r:
+            return r.read()
+    if url.startswith("file://"):
+        url = url[7:]
+    return open(url, "rb").read()
+
+
+def preprocess_inkling2v(raw_bytes):
+    """Preprocess image identically to mtmd_image_preprocessor_inkling2v -> (wp, hp, float32 patches [wp*hp, 1200])."""
+    import numpy as np
+    from PIL import Image
+
+    im = Image.open(io.BytesIO(raw_bytes)).convert("RGB")
+    w, h = im.size
+    align = 40
+    max_pixels = 4096 * align * align
+    aw = ((w + align - 1) // align) * align
+    ah = ((h + align - 1) // align) * align
+    if aw * ah > max_pixels:
+        scale = math.sqrt(max_pixels / float(w * h))
+        nw = max(align, int(w * scale))
+        nh = max(align, int(h * scale))
+        while (((nw + align - 1) // align) * align) * (((nh + align - 1) // align) * align) > max_pixels:
+            nw = max(align, nw - align)
+            nh = max(align, nh - align)
+        im = im.resize((nw, nh), Image.Resampling.LANCZOS)
+        w, h = im.size
+        aw = ((w + align - 1) // align) * align
+        ah = ((h + align - 1) // align) * align
+    arr = np.full((ah, aw, 3), -1.0, dtype=np.float32)
+    arr[:h, :w, :] = np.asarray(im, dtype=np.float32)
+    arr = (arr - 127.5) / 127.5
+    wp, hp = aw // 20, ah // 20
+    # [hp, 20, wp, 20, 3] -> [hp, wp, 3, 20, 20] -> [wp*hp, 1200]
+    patches = arr.reshape(hp, 20, wp, 20, 3).transpose(0, 2, 4, 1, 3).reshape(wp * hp, 1200)
+    return wp, hp, np.ascontiguousarray(patches, dtype=np.float32)
+
