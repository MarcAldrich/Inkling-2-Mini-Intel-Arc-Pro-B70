new file mode 100644
index 00000000..5ac77815
--- /dev/null
+++ b/zig/kernels/xpu/inkling2/vit.cl
@@ -0,0 +1,353 @@
+// Inkling 2 Mini vision tower (inkling2v, 23-layer ViT + 2x2 merge + 2-layer GELU MLP) on Intel Xe2 XMX.
+#pragma OPENCL EXTENSION cl_khr_fp16 : enable
+#pragma OPENCL FP_CONTRACT OFF
+
+#define KERNEL(N) __attribute__((intel_reqd_sub_group_size(16))) __attribute__((reqd_work_group_size(N, 1, 1))) kernel
+#define VD 1024
+#define VNH 16
+#define VHD 64
+
+static inline float gelu_erf(float x) { return 0.5f * x * (1.0f + erf(x * 0.7071067811865475f)); }
+
+static float wg_sum256(float v, local float *red) {
+  const float s = sub_group_reduce_add(v);
+  if (get_sub_group_local_id() == 0) red[get_sub_group_id()] = s;
+  barrier(CLK_LOCAL_MEM_FENCE);
+  float t = 0.0f;
+  for (int i = 0; i < 16; i++) t += red[i];
+  barrier(CLK_LOCAL_MEM_FENCE);
+  return t;
+}
+
+// F16 weight GEMM on Xe2 XMX: Y[M,N] = X[M,K] @ W[N,K]^T + bias, optional GELU_ERF; grid (N/64, (M+15)/16).
+KERNEL(64) void vit_gemm_f16_xmx(global const float *X, global const half *W, global const float *bias,
+                                 global float *Y, int M, int N, int K, int do_gelu) {
+  local short xl[16][16];
+  local uint wl[64][9];
+  const int t = get_local_id(0), lane = get_sub_group_local_id(), sg = get_sub_group_id();
+  const int r_wg = get_group_id(0) * 64, m0 = get_group_id(1) * 16;
+  const int r = r_wg + sg * 16 + lane;
+  const int nm = min(16, M - m0);
+  if (r_wg >= N || nm <= 0) return;
+
+  float8 acc0 = (float8)(0.0f), acc1 = (float8)(0.0f);
+  const int k16_n = K / 16;
+  for (int k16 = 0; k16 < k16_n; k16++) {
+    const int ko = k16 * 16;
+    const int xr = t >> 2, xc = (t & 3) * 4;
+    if (xr < nm) {
+      const short4 hs = as_short4(convert_half4(vload4(0, X + (long)(m0 + xr) * K + ko + xc)));
+      xl[xr][xc + 0] = hs.s0;
+      xl[xr][xc + 1] = hs.s1;
+      xl[xr][xc + 2] = hs.s2;
+      xl[xr][xc + 3] = hs.s3;
+    } else {
+      xl[xr][xc + 0] = 0;
+      xl[xr][xc + 1] = 0;
+      xl[xr][xc + 2] = 0;
+      xl[xr][xc + 3] = 0;
+    }
+    const int wr_l = t >> 3, wc_l = t & 7;
+    for (int rb = 0; rb < 64; rb += 8) {
+      const int wr = rb + wr_l;
+      wl[wr][wc_l] = ((global const uint *)(W + (long)(r_wg + wr) * K + ko))[wc_l];
+    }
+    barrier(CLK_LOCAL_MEM_FENCE);
+
+    const int rr = sg * 16 + lane;
+    short8 a0, a1;
+#pragma unroll
+    for (int m = 0; m < 8; m++) {
+      a0[m] = xl[m][lane];
+      a1[m] = xl[8 + m][lane];
+    }
+    const int8 b = (int8)(wl[rr][0], wl[rr][1], wl[rr][2], wl[rr][3], wl[rr][4], wl[rr][5], wl[rr][6], wl[rr][7]);
+    acc0 = intel_sub_group_f16_f16_matrix_mad_k16(a0, b, acc0);
+    if (nm > 8) acc1 = intel_sub_group_f16_f16_matrix_mad_k16(a1, b, acc1);
+    barrier(CLK_LOCAL_MEM_FENCE);
+  }
+
+  const float bv = bias ? bias[r] : 0.0f;
+  for (int m = 0; m < 8; m++) {
+    if (m < nm) {
+      float v = acc0[m] + bv;
+      if (do_gelu) v = gelu_erf(v);
+      Y[(long)(m0 + m) * N + r] = v;
+    }
+    if (8 + m < nm) {
+      float v = acc1[m] + bv;
+      if (do_gelu) v = gelu_erf(v);
+      Y[(long)(m0 + 8 + m) * N + r] = v;
+    }
+  }
+}
+
+// Prepend CLS+cls_pos at row 0 and add bilinear-resized 32x32 pos_embd to patches; grid N_patches + 1.
+KERNEL(256) void vit_add_pos_cls(global const float *patch, global const float *cls, global const float *cls_pos,
+                                 global const float *pos_embd, int wp, int hp, global float *out) {
+  const int row = get_group_id(0), t = get_local_id(0);
+  if (row == 0) {
+    for (int i = 0; i < 4; i++) {
+      const int c = t + i * 256;
+      out[c] = cls[c] + cls_pos[c];
+    }
+    return;
+  }
+  const int pidx = row - 1;
+  const int py = pidx / wp, px = pidx - py * wp;
+  const float fy = ((float)py + 0.5f) * (32.0f / (float)hp) - 0.5f;
+  const float fx = ((float)px + 0.5f) * (32.0f / (float)wp) - 0.5f;
+  const int y0 = clamp((int)floor(fy), 0, 31), y1 = clamp(y0 + 1, 0, 31);
+  const int x0 = clamp((int)floor(fx), 0, 31), x1 = clamp(x0 + 1, 0, 31);
+  const float dy = clamp(fy - (float)y0, 0.0f, 1.0f);
+  const float dx = clamp(fx - (float)x0, 0.0f, 1.0f);
+  const float w00 = (1.0f - dy) * (1.0f - dx), w01 = (1.0f - dy) * dx;
+  const float w10 = dy * (1.0f - dx), w11 = dy * dx;
+  const long o00 = (long)(y0 * 32 + x0) * VD, o01 = (long)(y0 * 32 + x1) * VD;
+  const long o10 = (long)(y1 * 32 + x0) * VD, o11 = (long)(y1 * 32 + x1) * VD;
+  for (int i = 0; i < 4; i++) {
+    const int c = t + i * 256;
+    const float pe = (wp == 32 && hp == 32)
+                         ? pos_embd[(long)pidx * VD + c]
+                         : (w00 * pos_embd[o00 + c] + w01 * pos_embd[o01 + c] + w10 * pos_embd[o10 + c] +
+                            w11 * pos_embd[o11 + c]);
+    out[(long)row * VD + c] = patch[(long)pidx * VD + c] + pe;
+  }
+}
+
+// Standard LayerNorm on D=1024 (4 floats/thread); grid N_pos.
+KERNEL(256) void vit_ln(global const float *x, global const float *w, global const float *b, float eps,
+                        global float *y) {
+  local float red[16];
+  const int row = get_group_id(0), t = get_local_id(0);
+  global const float *xr = x + (long)row * VD;
+  float v[4], s = 0.0f;
+  for (int i = 0; i < 4; i++) {
+    v[i] = xr[t + i * 256];
+    s += v[i];
+  }
+  const float mean = wg_sum256(s, red) * (1.0f / (float)VD);
+  float vs = 0.0f;
+  for (int i = 0; i < 4; i++) {
+    v[i] -= mean;
+    vs += v[i] * v[i];
+  }
+  const float inv = rsqrt(wg_sum256(vs, red) * (1.0f / (float)VD) + eps);
+  global float *yr = y + (long)row * VD;
+  for (int i = 0; i < 4; i++) {
+    const int c = t + i * 256;
+    yr[c] = v[i] * inv * w[c] + b[c];
+  }
+}
+
+// 2D RoPE (GGML_ROPE_TYPE_NORMAL, theta=10000, d_head=64) in-place on Q and K; grid N_pos.
+KERNEL(256) void vit_rope2d(global float *Q, global float *K, int wp) {
+  const int row = get_group_id(0), t = get_local_id(0);
+  if (row == 0) return;
+  const int pidx = row - 1;
+  const int py = pidx / wp, px = pidx - py * wp;
+  const float pw = (float)(px + 1), ph = (float)(py + 1);
+  const int h = t >> 4, i = t & 15;
+  const float inv_f = pow(10000.0f, -2.0f * (float)i / 32.0f);
+  const float cw = cos(pw * inv_f), sw = sin(pw * inv_f);
+  const float ch = cos(ph * inv_f), sh = sin(ph * inv_f);
+  const long base = (long)row * VD + h * VHD;
+  const int i0 = 2 * i, i1 = 32 + 2 * i;
+  const float q0 = Q[base + i0], q1 = Q[base + i0 + 1];
+  Q[base + i0] = q0 * cw - q1 * sw;
+  Q[base + i0 + 1] = q0 * sw + q1 * cw;
+  const float q2 = Q[base + i1], q3 = Q[base + i1 + 1];
+  Q[base + i1] = q2 * ch - q3 * sh;
+  Q[base + i1 + 1] = q2 * sh + q3 * ch;
+  const float k0 = K[base + i0], k1 = K[base + i0 + 1];
+  K[base + i0] = k0 * cw - k1 * sw;
+  K[base + i0 + 1] = k0 * sw + k1 * cw;
+  const float k2 = K[base + i1], k3 = K[base + i1 + 1];
+  K[base + i1] = k2 * ch - k3 * sh;
+  K[base + i1 + 1] = k2 * sh + k3 * ch;
+}
+
+// Bidirectional FlashAttention on Xe2 XMX DPAS (16 heads, d_head=64, 16 Q/WG, 64 K/tile); grid (16, (N+15)/16).
+KERNEL(128) void vit_attn_xmx(global const float *Q, global const float *K, global const float *V, global float *O,
+                              int N) {
+  local uint ql[4][8][16];
+  local short kv[64][64];
+  local half Pl[16 * 64];
+  local float MX[8 * 16], SM[8 * 16];
+
+  const int h = get_group_id(0), q0 = get_group_id(1) * 16;
+  const int t = get_local_id(0), sg = get_sub_group_id(), lane = get_sub_group_local_id();
+  const int qtok = q0 + lane;
+  const bool qok = qtok < N;
+
+  for (int idx = t; idx < 512; idx += 128) {
+    const int slot = idx & 15, j = idx >> 4;
+    const int tk = q0 + slot;
+    uint val = 0u;
+    if (tk < N) {
+      const float2 q2 = vload2(j, Q + (long)tk * VD + h * VHD) * 0.125f;
+      val = as_uint(convert_half2(q2));
+    }
+    ql[j >> 3][j & 7][slot] = val;
+  }
+  barrier(CLK_LOCAL_MEM_FENCE);
+
+  float mrun = -INFINITY, lrun = 0.0f;
+  float8 orun = (float8)(0.0f);
+  const int q_half = sg >> 2;
+  const int d_blk = (sg & 3) * 16;
+
+  for (int ts = 0; ts < N; ts += 64) {
+    for (int r0 = 0; r0 < 64; r0 += 8) {
+      const int kr = r0 + (t >> 4);
+      const int kc = (t & 15) * 4;
+      if (ts + kr < N) {
+        const short4 hs = as_short4(convert_half4(vload4(0, K + (long)(ts + kr) * VD + h * VHD + kc)));
+        kv[kr][kc + 0] = hs.s0;
+        kv[kr][kc + 1] = hs.s1;
+        kv[kr][kc + 2] = hs.s2;
+        kv[kr][kc + 3] = hs.s3;
+      } else {
+        kv[kr][kc + 0] = 0;
+        kv[kr][kc + 1] = 0;
+        kv[kr][kc + 2] = 0;
+        kv[kr][kc + 3] = 0;
+      }
+    }
+    barrier(CLK_LOCAL_MEM_FENCE);
+
+    float8 s = (float8)(0.0f);
+#pragma unroll
+    for (int ds = 0; ds < 4; ds++) {
+      short8 ka;
+#pragma unroll
+      for (int r = 0; r < 8; r++) ka[r] = kv[sg * 8 + r][ds * 16 + lane];
+      const int8 qb = (int8)(ql[ds][0][lane], ql[ds][1][lane], ql[ds][2][lane], ql[ds][3][lane],
+                             ql[ds][4][lane], ql[ds][5][lane], ql[ds][6][lane], ql[ds][7][lane]);
+      s = intel_sub_group_f16_f16_matrix_mad_k16(ka, qb, s);
+    }
+
+    float mx = -INFINITY;
+#pragma unroll
+    for (int r = 0; r < 8; r++) {
+      const int kk = ts + sg * 8 + r;
+      const float x = (qok && kk < N) ? s[r] : -INFINITY;
+      s[r] = x;
+      mx = fmax(mx, x);
+    }
+    MX[sg * 16 + lane] = mx;
+    barrier(CLK_LOCAL_MEM_FENCE);
+
+    float m = -INFINITY;
+#pragma unroll
+    for (int i = 0; i < 8; i++) m = fmax(m, MX[i * 16 + lane]);
+    float sum = 0.0f;
+#pragma unroll
+    for (int r = 0; r < 8; r++) {
+      const float p = (s[r] == -INFINITY) ? 0.0f : exp(s[r] - m);
+      Pl[lane * 64 + sg * 8 + r] = convert_half(p);
+      sum += p;
+    }
+    SM[sg * 16 + lane] = sum;
+    barrier(CLK_LOCAL_MEM_FENCE);
+
+    float l = 0.0f;
+#pragma unroll
+    for (int i = 0; i < 8; i++) l += SM[i * 16 + lane];
+
+    float fa = 1.0f, fb = 0.0f;
+    if (qok && m > -INFINITY) {
+      if (mrun == -INFINITY) {
+        fa = 0.0f;
+        fb = 1.0f;
+        mrun = m;
+        lrun = l;
+      } else {
+        const float mm = fmax(mrun, m);
+        fa = exp(mrun - mm);
+        fb = exp(m - mm);
+        lrun = lrun * fa + l * fb;
+        mrun = mm;
+      }
+    }
+
+    for (int r0 = 0; r0 < 64; r0 += 8) {
+      const int vr = r0 + (t >> 4);
+      const int vc = (t & 15) * 4;
+      if (ts + vr < N) {
+        const short4 hs = as_short4(convert_half4(vload4(0, V + (long)(ts + vr) * VD + h * VHD + vc)));
+        kv[vr][vc + 0] = hs.s0;
+        kv[vr][vc + 1] = hs.s1;
+        kv[vr][vc + 2] = hs.s2;
+        kv[vr][vc + 3] = hs.s3;
+      } else {
+        kv[vr][vc + 0] = 0;
+        kv[vr][vc + 1] = 0;
+        kv[vr][vc + 2] = 0;
+        kv[vr][vc + 3] = 0;
+      }
+    }
+    barrier(CLK_LOCAL_MEM_FENCE);
+
+    float8 ot = (float8)(0.0f);
+    const int p_off = q_half * 8;
+#pragma unroll
+    for (int c = 0; c < 4; c++) {
+      short8 a;
+#pragma unroll
+      for (int mm = 0; mm < 8; mm++) a[mm] = as_short(Pl[(p_off + mm) * 64 + c * 16 + lane]);
+      int8 b;
+#pragma unroll
+      for (int kk = 0; kk < 8; kk++) {
+        const ushort lo = as_ushort(kv[c * 16 + kk * 2][d_blk + lane]);
+        const ushort hi = as_ushort(kv[c * 16 + kk * 2 + 1][d_blk + lane]);
+        b[kk] = (int)((uint)lo | ((uint)hi << 16));
+      }
+      ot = intel_sub_group_f16_f16_matrix_mad_k16(a, b, ot);
+    }
+#pragma unroll
+    for (int i = 0; i < 8; i++) {
+      orun[i] = orun[i] * sub_group_broadcast(fa, p_off + i) + ot[i] * sub_group_broadcast(fb, p_off + i);
+    }
+    barrier(CLK_LOCAL_MEM_FENCE);
+  }
+
+  const int p_off = q_half * 8;
+#pragma unroll
+  for (int i = 0; i < 8; i++) {
+    const int tk = q0 + p_off + i;
+    if (tk < N) {
+      const float lf = sub_group_broadcast(lrun, p_off + i);
+      O[(long)tk * VD + h * VHD + d_blk + lane] = orun[i] / lf;
+    }
+  }
+}
+
+// Residual + LayerScale: x[row, c] += y[row, c] * ls[c] (D=1024); grid N_pos.
+KERNEL(256) void vit_ls_add(global float *x, global const float *y, global const float *ls) {
+  const int row = get_group_id(0), t = get_local_id(0);
+  const long base = (long)row * VD;
+  for (int i = 0; i < 4; i++) {
+    const int c = t + i * 256;
+    x[base + c] += y[base + c] * ls[c];
+  }
+}
+
+// 2x2 spatial patch merge (drops CLS row 0): [N_patches, 1024] -> [(wp/2)*(hp/2), 4096]; grid (wp/2)*(hp/2).
+KERNEL(256) void vit_merge_2x2(global const float *x, int wp, global float *out) {
+  const int out_idx = get_group_id(0), t = get_local_id(0);
+  const int mw = wp >> 1;
+  const int gy = out_idx / mw, gx = out_idx - gy * mw;
+  const int p00 = 1 + (2 * gy) * wp + (2 * gx);
+  const int p01 = p00 + 1;
+  const int p10 = 1 + (2 * gy + 1) * wp + (2 * gx);
+  const int p11 = p10 + 1;
+  global float *dst = out + (long)out_idx * (4 * VD);
+  for (int i = 0; i < 4; i++) {
+    const int c = t + i * 256;
+    dst[0 * VD + c] = x[(long)p00 * VD + c];
+    dst[1 * VD + c] = x[(long)p01 * VD + c];
+    dst[2 * VD + c] = x[(long)p10 * VD + c];
+    dst[3 * VD + c] = x[(long)p11 * VD + c];
+  }
+}
