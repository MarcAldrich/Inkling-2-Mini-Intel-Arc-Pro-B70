+// Mixed text/image prompt embed: tok >= 0 uses Q8_0 + embed_norm; tok < 0 copies img_embd[tok & 0x7fffffff] raw.
+KERNEL(256) void ink2_embed_mix_b(global const char *q, global const half *s, global const int *ids,
+                                  global const float *gamma, float eps, global const float *img_embd,
+                                  global float *out) {
+  local float red[16];
+  const int t = get_local_id(0), row = get_group_id(0), tok = ids[row];
+  if (tok < 0) {
+    const long idx = (long)(tok & 0x7fffffff);
+    for (int i = 0; i < 9; i++) {
+      const int c = t + i * 256;
+      out[(long)row * C + c] = img_embd[idx * C + c];
+    }
+    return;
+  }
+  float v[9], ss = 0.0f;
+  for (int i = 0; i < 9; i++) {
+    const int c = t + i * 256;
+    v[i] = (float)q[(long)tok * C + c] * (float)s[(long)tok * (C / 32) + c / 32];
+    ss += v[i] * v[i];
+  }
+  const float r = rsqrt(wg_sum(ss, red) / C + eps);
+  for (int i = 0; i < 9; i++) out[(long)row * C + t + i * 256] = v[i] * r * gamma[t + i * 256];
+}
