+//! Inkling 2 Mini vision tower (mmproj-F16.gguf, inkling2v) on Intel Xe2 XMX.
+const std = @import("std");
+const ze = @import("ze");
+const gguf = @import("gguf");
+const kbin = @import("xpu_inkling2_kernels");
+
+const alloc = std.heap.c_allocator;
+
+pub const VD: usize = 1024;
+pub const VFF: usize = 4096;
+pub const VLAYERS: usize = 23;
+pub const PATCH_DIM: usize = 3 * 20 * 20;
+pub const PROJ_OUT: usize = 2304;
+pub const EPS: f32 = 1e-5;
+
+const VitLayer = struct {
+    ln1_w: *anyopaque,
+    ln1_b: *anyopaque,
+    ln2_w: *anyopaque,
+    ln2_b: *anyopaque,
+    ls1_w: *anyopaque,
+    ls2_w: *anyopaque,
+    q_w: *anyopaque,
+    q_b: *anyopaque,
+    k_w: *anyopaque,
+    k_b: *anyopaque,
+    v_w: *anyopaque,
+    v_b: *anyopaque,
+    o_w: *anyopaque,
+    o_b: *anyopaque,
+    up_w: *anyopaque,
+    up_b: *anyopaque,
+    down_w: *anyopaque,
+    down_b: *anyopaque,
+};
+
+const VitK = struct {
+    gemm: ze.H,
+    add_pos: ze.H,
+    ln: ze.H,
+    rope2d: ze.H,
+    attn: ze.H,
+    ls_add: ze.H,
+    merge2x2: ze.H,
+};
+
+pub const Vit = struct {
+    k: VitK,
+    cls: *anyopaque,
+    cls_pos: *anyopaque,
+    patch_w: *anyopaque,
+    pos_embd: *anyopaque,
+    pre_ln_w: *anyopaque,
+    pre_ln_b: *anyopaque,
+    mm1_w: *anyopaque,
+    mm2_w: *anyopaque,
+    layers: [VLAYERS]VitLayer,
+    // Reusable scratch sized dynamically to max_pos.
+    cap_pos: usize = 0,
+    buf_patch: *anyopaque = undefined,
+    buf_pout: *anyopaque = undefined,
+    buf_x: *anyopaque = undefined,
+    buf_h: *anyopaque = undefined,
+    buf_q: *anyopaque = undefined,
+    buf_k: *anyopaque = undefined,
+    buf_v: *anyopaque = undefined,
+    buf_o: *anyopaque = undefined,
+    buf_ff: *anyopaque = undefined,
+
+    fn need(doc: *const gguf.Document, name: []const u8) !gguf.Tensor {
+        return doc.getTensor(name) orelse {
+            std.debug.print("mmproj: missing tensor {s}\n", .{name});
+            return error.MissingTensor;
+        };
+    }
+
+    fn uploadRaw(d: anytype, doc: *const gguf.Document, name: []const u8, comptime kind: anytype) !*anyopaque {
+        const t = try need(doc, name);
+        if (t.kind != kind) {
+            std.debug.print("mmproj: unexpected kind for {s}\n", .{name});
+            return error.UnexpectedTensorType;
+        }
+        return d.upload(t.bytes);
+    }
+
+    pub fn load(d: anytype, raw: []const u8) !Vit {
+        const doc = try gguf.Document.parse(alloc, raw, .{});
+        const mod = try d.g.module(kbin.vit[0..]);
+        var v: Vit = undefined;
+        v.cap_pos = 0;
+        v.k = .{
+            .gemm = try d.g.kernel(mod, "vit_gemm_f16_xmx"),
+            .add_pos = try d.g.kernel(mod, "vit_add_pos_cls"),
+            .ln = try d.g.kernel(mod, "vit_ln"),
+            .rope2d = try d.g.kernel(mod, "vit_rope2d"),
+            .attn = try d.g.kernel(mod, "vit_attn_xmx"),
+            .ls_add = try d.g.kernel(mod, "vit_ls_add"),
+            .merge2x2 = try d.g.kernel(mod, "vit_merge_2x2"),
+        };
+        v.cls = try uploadRaw(d, &doc, "v.class_embd", .f32);
+        v.cls_pos = try uploadRaw(d, &doc, "v.class_position_embd.weight", .f32);
+        v.patch_w = try uploadRaw(d, &doc, "v.patch_embd.weight", .f16);
+        v.pos_embd = try uploadRaw(d, &doc, "v.position_embd.weight", .f32);
+        v.pre_ln_w = try uploadRaw(d, &doc, "v.pre_ln.weight", .f32);
+        v.pre_ln_b = try uploadRaw(d, &doc, "v.pre_ln.bias", .f32);
+        v.mm1_w = try uploadRaw(d, &doc, "mm.1.weight", .f16);
+        v.mm2_w = try uploadRaw(d, &doc, "mm.2.weight", .f16);
+        var nb: [64]u8 = undefined;
+        for (0..VLAYERS) |il| {
+            v.layers[il] = .{
+                .ln1_w = try uploadRaw(d, &doc, try std.fmt.bufPrint(&nb, "v.blk.{d}.ln1.weight", .{il}), .f32),
+                .ln1_b = try uploadRaw(d, &doc, try std.fmt.bufPrint(&nb, "v.blk.{d}.ln1.bias", .{il}), .f32),
+                .ln2_w = try uploadRaw(d, &doc, try std.fmt.bufPrint(&nb, "v.blk.{d}.ln2.weight", .{il}), .f32),
+                .ln2_b = try uploadRaw(d, &doc, try std.fmt.bufPrint(&nb, "v.blk.{d}.ln2.bias", .{il}), .f32),
+                .ls1_w = try uploadRaw(d, &doc, try std.fmt.bufPrint(&nb, "v.blk.{d}.ls1.weight", .{il}), .f32),
+                .ls2_w = try uploadRaw(d, &doc, try std.fmt.bufPrint(&nb, "v.blk.{d}.ls2.weight", .{il}), .f32),
+                .q_w = try uploadRaw(d, &doc, try std.fmt.bufPrint(&nb, "v.blk.{d}.attn_q.weight", .{il}), .f16),
+                .q_b = try uploadRaw(d, &doc, try std.fmt.bufPrint(&nb, "v.blk.{d}.attn_q.bias", .{il}), .f32),
+                .k_w = try uploadRaw(d, &doc, try std.fmt.bufPrint(&nb, "v.blk.{d}.attn_k.weight", .{il}), .f16),
+                .k_b = try uploadRaw(d, &doc, try std.fmt.bufPrint(&nb, "v.blk.{d}.attn_k.bias", .{il}), .f32),
+                .v_w = try uploadRaw(d, &doc, try std.fmt.bufPrint(&nb, "v.blk.{d}.attn_v.weight", .{il}), .f16),
+                .v_b = try uploadRaw(d, &doc, try std.fmt.bufPrint(&nb, "v.blk.{d}.attn_v.bias", .{il}), .f32),
+                .o_w = try uploadRaw(d, &doc, try std.fmt.bufPrint(&nb, "v.blk.{d}.attn_out.weight", .{il}), .f16),
+                .o_b = try uploadRaw(d, &doc, try std.fmt.bufPrint(&nb, "v.blk.{d}.attn_out.bias", .{il}), .f32),
+                .up_w = try uploadRaw(d, &doc, try std.fmt.bufPrint(&nb, "v.blk.{d}.ffn_up.weight", .{il}), .f16),
+                .up_b = try uploadRaw(d, &doc, try std.fmt.bufPrint(&nb, "v.blk.{d}.ffn_up.bias", .{il}), .f32),
+                .down_w = try uploadRaw(d, &doc, try std.fmt.bufPrint(&nb, "v.blk.{d}.ffn_down.weight", .{il}), .f16),
+                .down_b = try uploadRaw(d, &doc, try std.fmt.bufPrint(&nb, "v.blk.{d}.ffn_down.bias", .{il}), .f32),
+            };
+        }
+        return v;
+    }
+
+    fn ensureScratch(v: *Vit, d: anytype, n_pos: usize) !void {
+        if (n_pos <= v.cap_pos) return;
+        const cap = @max(n_pos, 1025);
+        v.buf_patch = try d.alloc_(cap * PATCH_DIM * 4);
+        v.buf_pout = try d.alloc_(cap * VD * 4);
+        v.buf_x = try d.alloc_(cap * VD * 4);
+        v.buf_h = try d.alloc_(cap * VD * 4);
+        v.buf_q = try d.alloc_(cap * VD * 4);
+        v.buf_k = try d.alloc_(cap * VD * 4);
+        v.buf_v = try d.alloc_(cap * VD * 4);
+        v.buf_o = try d.alloc_(cap * VD * 4);
+        v.buf_ff = try d.alloc_(cap * VFF * 4);
+        v.cap_pos = cap;
+    }
+
+    /// Encode [wp*hp, 1200] float32 patches into [(wp/2)*(hp/2), 2304] float32 embeddings at `dst`.
+    pub fn encode(v: *Vit, d: anytype, patches_bytes: []const u8, wp: usize, hp: usize, dst: *anyopaque) !usize {
+        if (wp == 0 or hp == 0 or (wp & 1) != 0 or (hp & 1) != 0) return error.BadImageGrid;
+        const n_patches = wp * hp;
+        const n_pos = n_patches + 1;
+        const n_img = (wp / 2) * (hp / 2);
+        if (patches_bytes.len != n_patches * PATCH_DIM * 4) return error.BadImageBytes;
+        try v.ensureScratch(d, n_pos);
+        try d.copyIn(v.buf_patch, patches_bytes);
+
+        const null_p: ?*anyopaque = null;
+        const np_i: i32 = @intCast(n_patches);
+        const npos_i: i32 = @intCast(n_pos);
+        const npos_u: u32 = @intCast(n_pos);
+        const tiles_p: u32 = @intCast((n_patches + 15) / 16);
+        const tiles_pos: u32 = @intCast((n_pos + 15) / 16);
+
+        // Patch embedding GEMM [n_patches, 1200] @ [1024, 1200]^T -> [n_patches, 1024].
+        try d.launch(v.k.gemm, .{ .x = VD / 64, .y = tiles_p }, .{ v.buf_patch, v.patch_w, null_p, v.buf_pout, np_i, @as(i32, VD), @as(i32, PATCH_DIM), @as(i32, 0) });
+        // Prepend CLS + add bilinear-resized 32x32 position embeddings -> buf_h, then pre_ln -> buf_x.
+        try d.launch(v.k.add_pos, .{ .x = npos_u }, .{ v.buf_pout, v.cls, v.cls_pos, v.pos_embd, @as(i32, @intCast(wp)), @as(i32, @intCast(hp)), v.buf_h });
+        try d.launch(v.k.ln, .{ .x = npos_u }, .{ v.buf_h, v.pre_ln_w, v.pre_ln_b, EPS, v.buf_x });
+
+        for (0..VLAYERS) |il| {
+            const l = &v.layers[il];
+            try d.launch(v.k.ln, .{ .x = npos_u }, .{ v.buf_x, l.ln1_w, l.ln1_b, EPS, v.buf_h });
+            try d.launch(v.k.gemm, .{ .x = VD / 64, .y = tiles_pos }, .{ v.buf_h, l.q_w, @as(?*anyopaque, l.q_b), v.buf_q, npos_i, @as(i32, VD), @as(i32, VD), @as(i32, 0) });
+            try d.launch(v.k.gemm, .{ .x = VD / 64, .y = tiles_pos }, .{ v.buf_h, l.k_w, @as(?*anyopaque, l.k_b), v.buf_k, npos_i, @as(i32, VD), @as(i32, VD), @as(i32, 0) });
+            try d.launch(v.k.gemm, .{ .x = VD / 64, .y = tiles_pos }, .{ v.buf_h, l.v_w, @as(?*anyopaque, l.v_b), v.buf_v, npos_i, @as(i32, VD), @as(i32, VD), @as(i32, 0) });
+            try d.launch(v.k.rope2d, .{ .x = npos_u }, .{ v.buf_q, v.buf_k, @as(i32, @intCast(wp)) });
+            try d.launch(v.k.attn, .{ .x = 16, .y = tiles_pos }, .{ v.buf_q, v.buf_k, v.buf_v, v.buf_o, npos_i });
+            try d.launch(v.k.gemm, .{ .x = VD / 64, .y = tiles_pos }, .{ v.buf_o, l.o_w, @as(?*anyopaque, l.o_b), v.buf_h, npos_i, @as(i32, VD), @as(i32, VD), @as(i32, 0) });
+            try d.launch(v.k.ls_add, .{ .x = npos_u }, .{ v.buf_x, v.buf_h, l.ls1_w });
+
+            try d.launch(v.k.ln, .{ .x = npos_u }, .{ v.buf_x, l.ln2_w, l.ln2_b, EPS, v.buf_h });
+            try d.launch(v.k.gemm, .{ .x = VFF / 64, .y = tiles_pos }, .{ v.buf_h, l.up_w, @as(?*anyopaque, l.up_b), v.buf_ff, npos_i, @as(i32, VFF), @as(i32, VD), @as(i32, 1) });
+            try d.launch(v.k.gemm, .{ .x = VD / 64, .y = tiles_pos }, .{ v.buf_ff, l.down_w, @as(?*anyopaque, l.down_b), v.buf_h, npos_i, @as(i32, VD), @as(i32, VFF), @as(i32, 0) });
+            try d.launch(v.k.ls_add, .{ .x = npos_u }, .{ v.buf_x, v.buf_h, l.ls2_w });
+        }
+
+        // Drop CLS + 2x2 merge into buf_ff [n_img, 4096], then 2-layer GELU projector into dst [n_img, 2304].
+        const nimg_i: i32 = @intCast(n_img);
+        const tiles_img: u32 = @intCast((n_img + 15) / 16);
+        try d.launch(v.k.merge2x2, .{ .x = @as(u32, @intCast(n_img)) }, .{ v.buf_x, @as(i32, @intCast(wp)), v.buf_ff });
+        // Reuse buf_patch (cap_pos * 1200 >= n_img * 4096 since cap_pos >= 4*n_img) for mm.1 output.
+        try d.launch(v.k.gemm, .{ .x = VFF / 64, .y = tiles_img }, .{ v.buf_ff, v.mm1_w, null_p, v.buf_patch, nimg_i, @as(i32, VFF), @as(i32, VFF), @as(i32, 1) });
+        try d.launch(v.k.gemm, .{ .x = PROJ_OUT / 64, .y = tiles_img }, .{ v.buf_patch, v.mm2_w, null_p, dst, nimg_i, @as(i32, PROJ_OUT), @as(i32, VFF), @as(i32, 0) });
+        try d.sync();
+        return n_img;
+    }
+};
