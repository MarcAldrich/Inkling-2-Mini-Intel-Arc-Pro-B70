+// Quantize nsel vectors of K floats (K % 128 == 0) into Q8_1 (int8 + fp32 scale/32); grid (K / 128, nsel).
+KERNEL(64) void ink2_quant_q8(global const float *x, int K, global char *xq, global float *xs) {
+  const int lane = get_sub_group_local_id(), sg = get_sub_group_id();
+  const int blk = get_group_id(0) * 4 + sg;
+  const int j = get_group_id(1);
+  const int ks = K / 32;
+  const int off_ = j * K + blk * 32 + lane * 2;
+  const float2 v = vload2(0, x + off_);
+  const float amax = sub_group_reduce_max(fmax(fabs(v.x), fabs(v.y)));
+  const float scale = amax * (1.0f / 127.0f);
+  const float inv = amax > 0.0f ? (127.0f / amax) : 0.0f;
+  const char2 q = (char2)((char)clamp((int)rint(v.x * inv), -127, 127), (char)clamp((int)rint(v.y * inv), -127, 127));
+  vstore2(q, 0, xq + off_);
+  if (lane == 0) xs[j * ks + blk] = scale;
+}
+
+static inline int dp4a_blk32(char16 w0, char16 w1, char16 x0, char16 x1) {
+  int d = dot_acc_sat(w0.s0123, x0.s0123, 0);
+  d = dot_acc_sat(w0.s4567, x0.s4567, d);
+  d = dot_acc_sat(w0.s89ab, x0.s89ab, d);
+  d = dot_acc_sat(w0.scdef, x0.scdef, d);
+  d = dot_acc_sat(w1.s0123, x1.s0123, d);
+  d = dot_acc_sat(w1.s4567, x1.s4567, d);
+  d = dot_acc_sat(w1.s89ab, x1.s89ab, d);
+  return dot_acc_sat(w1.scdef, x1.scdef, d);
+}
+
+static float4 q8_row4_dp4a(global const char *q, global const half *s, int K, global const char *xq, global const float *xs) {
+  const int lane = get_sub_group_local_id(), ks = K / 32;
+  float4 a = (float4)(0.0f);
+  for (int b = lane; b < ks; b += 16) {
+    const char16 x0 = vload16(2 * b, xq), x1 = vload16(2 * b + 1, xq);
+    const float sx = xs[b];
+    float d[4];
+    for (int i = 0; i < 4; i++) {
+      global const char *qr = q + (long)i * K;
+      const char16 w0 = vload16(2 * b, qr), w1 = vload16(2 * b + 1, qr);
+      d[i] = (float)dp4a_blk32(w0, w1, x0, x1) * ((float)s[(long)i * ks + b] * sx);
+    }
+    a += (float4)(d[0], d[1], d[2], d[3]);
+  }
+  return (float4)(sub_group_reduce_add(a.x), sub_group_reduce_add(a.y), sub_group_reduce_add(a.z), sub_group_reduce_add(a.w));
+}
+
+static float2 q8_row2_dp4a(global const char *q0, global const char *q1, global const half *s0, global const half *s1,
+                           int K, global const char *xq, global const float *xs) {
+  const int lane = get_sub_group_local_id(), ks = K / 32;
+  float a0 = 0.0f, a1 = 0.0f;
+  for (int b = lane; b < ks; b += 16) {
+    const char16 x0 = vload16(2 * b, xq), x1 = vload16(2 * b + 1, xq);
+    const float sx = xs[b];
+    const char16 w0a = vload16(2 * b, q0), w0b = vload16(2 * b + 1, q0);
+    const char16 w1a = vload16(2 * b, q1), w1b = vload16(2 * b + 1, q1);
+    a0 += (float)dp4a_blk32(w0a, w0b, x0, x1) * ((float)s0[b] * sx);
+    a1 += (float)dp4a_blk32(w1a, w1b, x0, x1) * ((float)s1[b] * sx);
+  }
+  return (float2)(sub_group_reduce_add(a0), sub_group_reduce_add(a1));
+}
