+// Batched Q8_0 gate_up + situ on Xe2 XMX (4 MXFP8/Q8_0 expert layers): 64 rows/WG, 16 tokens/pass. Grid (FF/64, NE).
+KERNEL(64) void ink2_gateup_q8_xmx(global const char *q, global const half *s, global const int *start,
