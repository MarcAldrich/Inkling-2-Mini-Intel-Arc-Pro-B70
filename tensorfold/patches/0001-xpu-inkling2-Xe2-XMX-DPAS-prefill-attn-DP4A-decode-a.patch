+    for (int i = 0; i < 8; i++) {
+      orun0[i] = orun0[i] * sub_group_broadcast(fa, i) + ot0[i] * sub_group_broadcast(fb, i);
+      orun1[i] = orun1[i] * sub_group_broadcast(fa, 8 + i) + ot1[i] * sub_group_broadcast(fb, 8 + i);
+    }
+    barrier(CLK_LOCAL_MEM_FENCE);
+  }
+
+  const int d = sg * 16 + lane;
+#pragma unroll
+  for (int i = 0; i < 8; i++) {
+    const int tk0 = t0 + i / 3;
+    if (tk0 < T) {
+      const int qh0 = kvh * 3 + (i % 3);
+      const float lf0 = sub_group_broadcast(lrun, i);
+      O[((long)tk0 * 24 + qh0) * HD + d] = (orun0[i] / lf0) * sigmoid1(P[(long)tk0 * PROWS + 3456 + qh0 * HD + d]);
+    }
+    if (i < 7) {
+      const int slot1 = 8 + i;
+      const int tk1 = t0 + slot1 / 3;
+      if (tk1 < T) {
+        const int qh1 = kvh * 3 + (slot1 % 3);
+        const float lf1 = sub_group_broadcast(lrun, slot1);
+        O[((long)tk1 * 24 + qh1) * HD + d] = (orun1[i] / lf1) * sigmoid1(P[(long)tk1 * PROWS + 3456 + qh1 * HD + d]);
+      }
+    }
+  }
+}
