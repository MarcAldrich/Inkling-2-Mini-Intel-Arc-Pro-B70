+// Embedding reading the next token id directly from GPU memory (enables zero-bubble pipelined decode).
+KERNEL(256) void ink2_embed_dev(global const char *q, global const half *s, global const int *tok_ptr,
+                                global const float *gamma, float eps, global float *out) {
+  local float red[16];
+  const int t = get_local_id(0), tok = tok_ptr[0];
+  float v[9], ss = 0.0f;
+  for (int i = 0; i < 9; i++) {
+    const int c = t + i * 256;
+    v[i] = (float)q[(long)tok * C + c] * (float)s[(long)tok * (C / 32) + c / 32];
+    ss += v[i] * v[i];
+  }
+  const float r = rsqrt(wg_sum(ss, red) / C + eps);
+  for (int i = 0; i < 9; i++) out[t + i * 256] = v[i] * r * gamma[t + i * 256];
+}
