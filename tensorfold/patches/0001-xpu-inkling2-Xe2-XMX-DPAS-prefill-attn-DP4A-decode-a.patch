-// ---------------------------------------------------------------- rms norm with gamma, one vector a work-group
+// ---------------------------------------------------------------- rms norm with gamma and optional Q8_1 quant
+static inline void quant4_32(float4 ov, int lane, global char *xq, global float *xs, int c, int ks_off) {
+  float mx = fmax(fmax(fabs(ov.x), fabs(ov.y)), fmax(fabs(ov.z), fabs(ov.w)));
+  mx = fmax(mx, intel_sub_group_shuffle_xor(mx, 1));
+  mx = fmax(mx, intel_sub_group_shuffle_xor(mx, 2));
+  mx = fmax(mx, intel_sub_group_shuffle_xor(mx, 4));
+  const float inv = mx > 0.0f ? (127.0f / mx) : 0.0f;
+  const char4 q = (char4)((char)clamp((int)rint(ov.x * inv), -127, 127), (char)clamp((int)rint(ov.y * inv), -127, 127),
+                          (char)clamp((int)rint(ov.z * inv), -127, 127), (char)clamp((int)rint(ov.w * inv), -127, 127));
+  vstore4(q, 0, xq + c);
+  if ((lane & 7) == 0) xs[ks_off + (c >> 5)] = mx * (1.0f / 127.0f);
+}
