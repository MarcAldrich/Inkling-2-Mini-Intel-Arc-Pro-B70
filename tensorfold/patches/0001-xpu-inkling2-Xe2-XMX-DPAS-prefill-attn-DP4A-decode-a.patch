+    ql[j >> 3][j & 7][slot] = val;
+  }
+  for (int idx = t; idx < 256; idx += 128) {
+    const int slot = idx >> 4;
+    const int d = idx & 15;
+    float rv = 0.0f;
+    if (slot < 15) {
+      const int tk = t0 + slot / 3;
+      if (tk < T) {
+        const int qh = kvh * 3 + (slot % 3);
+        rv = R[((long)tk * 24 + qh) * NR + d];
+      }
+    }
+    rf[slot][d] = rv;
+  }
+  barrier(CLK_LOCAL_MEM_FENCE);
+
+  const int dt = lane / 3;
+  const int hq = lane - dt * 3;
+  const int tok = t0 + dt;
+  const bool qok = (lane < 15) && (tok < T);
+  const int qpos = p0c + tok;
