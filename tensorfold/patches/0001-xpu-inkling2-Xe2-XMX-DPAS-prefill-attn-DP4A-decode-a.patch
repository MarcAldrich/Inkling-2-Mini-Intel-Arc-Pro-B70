+#pragma unroll
+      for (int mm = 0; mm < 8; mm++) {
+        a0[mm] = as_short(Pl[mm * 64 + c * 16 + lane]);
+        a1[mm] = as_short(Pl[(8 + mm) * 64 + c * 16 + lane]);
+      }
+      uint8 vw;
+      intel_sub_group_2d_block_read_transform_16b_16r16x1c(
+          (global void *)(Vc + kvh * HD), HD * 2, ring, 8 * HD * 2,
+          (int2)(sg * 16, (ts + c * 16) % ring), (private uint *)&vw);
+      ot0 = intel_sub_group_f16_f16_matrix_mad_k16(a0, as_int8(vw), ot0);
+      ot1 = intel_sub_group_f16_f16_matrix_mad_k16(a1, as_int8(vw), ot1);
+    }
