+  global const half *se = s + (long)e * rows * (C / 32);
+  const int rr = sg * 16 + lane;
+
+  for (int i0 = s0; i0 < s1; i0 += 16) {
+    const int nt = min(16, s1 - i0);
+    int tok_row[16];
+    for (int m = 0; m < 16; m++) tok_row[m] = m < nt ? (list[i0 + m] / TOP) : 0;
