+// LM head via DP4A (4 rows/sg, 256 threads); grid (rows + 63) / 64.
+KERNEL(256) void ink2_gemv_q8_4_dp4a(global const char *q, global const half *s, int rows, int K, global const char *xq,
+                                     global const float *xs, global float *y) {
+  const int r = (get_group_id(0) * 16 + get_sub_group_id()) * 4;
+  if (r >= rows) return;
+  const float4 v = q8_row4_dp4a(q + (long)r * K, s + (long)r * (K / 32), K, xq, xs);
