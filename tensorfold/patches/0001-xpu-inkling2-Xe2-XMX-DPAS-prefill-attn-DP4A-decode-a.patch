+          xl[mr][mc + 0] = hs.s0; xl[mr][mc + 1] = hs.s1; xl[mr][mc + 2] = hs.s2; xl[mr][mc + 3] = hs.s3;
+        } else {
+          xl[mr][mc + 0] = 0; xl[mr][mc + 1] = 0; xl[mr][mc + 2] = 0; xl[mr][mc + 3] = 0;
+        }
+      }
+      for (int rb = 0; rb < 64; rb += 4) {
+        const int wr = rb + (t >> 4);
+        const int wc = t & 15;
+        wg_slm[wr][wc] = ((global const uint *)(qe + (long)(j_wg + wr) * C + k64 * 64))[wc];
+        wu_slm[wr][wc] = ((global const uint *)(qe + (long)(FF + j_wg + wr) * C + k64 * 64))[wc];
+      }
+      sg_slm[t][0] = se[(long)(j_wg + t) * (C / 32) + k64 * 2];
+      sg_slm[t][1] = se[(long)(j_wg + t) * (C / 32) + k64 * 2 + 1];
+      su_slm[t][0] = se[(long)(FF + j_wg + t) * (C / 32) + k64 * 2];
+      su_slm[t][1] = se[(long)(FF + j_wg + t) * (C / 32) + k64 * 2 + 1];
+      barrier(CLK_LOCAL_MEM_FENCE);
+
+      for (int blk = 0; blk < 2; blk++) {
+        const int ko = blk * 32, wo = blk * 8;
+        short8 a00, a01;
+        for (int m = 0; m < 8; m++) {
+          a00[m] = xl[m][ko + lane];
+          a01[m] = xl[m][ko + 16 + lane];
+        }
+        const int8 bg0 = q8_unpack16(wg_slm[rr][wo + 0], wg_slm[rr][wo + 1], wg_slm[rr][wo + 2], wg_slm[rr][wo + 3]);
+        const int8 bg1 = q8_unpack16(wg_slm[rr][wo + 4], wg_slm[rr][wo + 5], wg_slm[rr][wo + 6], wg_slm[rr][wo + 7]);
+        const int8 bu0 = q8_unpack16(wu_slm[rr][wo + 0], wu_slm[rr][wo + 1], wu_slm[rr][wo + 2], wu_slm[rr][wo + 3]);
+        const int8 bu1 = q8_unpack16(wu_slm[rr][wo + 4], wu_slm[rr][wo + 5], wu_slm[rr][wo + 6], wu_slm[rr][wo + 7]);
+        const float scg = (float)sg_slm[rr][blk], scu = (float)su_slm[rr][blk];
+        float8 dg0 = intel_sub_group_f16_f16_matrix_mad_k16(a00, bg0, (float8)(0.0f));
+        dg0 = intel_sub_group_f16_f16_matrix_mad_k16(a01, bg1, dg0);
+        float8 du0 = intel_sub_group_f16_f16_matrix_mad_k16(a00, bu0, (float8)(0.0f));
+        du0 = intel_sub_group_f16_f16_matrix_mad_k16(a01, bu1, du0);
+        ag0 = fma(dg0, (float8)(scg), ag0);
+        au0 = fma(du0, (float8)(scu), au0);
+        if (nt > 8) {
+          short8 a10, a11;
+          for (int m = 0; m < 8; m++) {
+            a10[m] = xl[8 + m][ko + lane];
+            a11[m] = xl[8 + m][ko + 16 + lane];
+          }
+          float8 dg1 = intel_sub_group_f16_f16_matrix_mad_k16(a10, bg0, (float8)(0.0f));
+          dg1 = intel_sub_group_f16_f16_matrix_mad_k16(a11, bg1, dg1);
+          float8 du1 = intel_sub_group_f16_f16_matrix_mad_k16(a10, bu0, (float8)(0.0f));
+          du1 = intel_sub_group_f16_f16_matrix_mad_k16(a11, bu1, du1);
+          ag1 = fma(dg1, (float8)(scg), ag1);
+          au1 = fma(du1, (float8)(scu), au1);
+        }
+      }
+      barrier(CLK_LOCAL_MEM_FENCE);
+    }
+    for (int m = 0; m < 8; m++) {
+      if (m < nt) act[(long)list[i0 + m] * FF + j] = situ(ag0[m], au0[m], b, lb);
+      if (8 + m < nt) act[(long)list[i0 + 8 + m] * FF + j] = situ(ag1[m], au1[m], b, lb);
+    }
+  }
