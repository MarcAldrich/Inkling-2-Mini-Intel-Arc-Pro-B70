+        const float lsw = lut16[s_slm[rr][u]];
+        const float8 dw0 = intel_sub_group_f16_f16_matrix_mad_k16(a0, bw, (float8)(0.0f));
+        acc0 = fma(dw0, (float8)(lsw), acc0);
+        if (nt > 8) {
+          short8 a1;
+          for (int m = 0; m < 8; m++) a1[m] = xl[8 + m][ko];
