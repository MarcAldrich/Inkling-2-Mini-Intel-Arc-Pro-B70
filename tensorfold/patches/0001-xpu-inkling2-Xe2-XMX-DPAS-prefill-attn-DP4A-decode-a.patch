+
+// Q8_0 experts down + post conv + residual via DP4A (2 rows/sg, 64 threads = 8 rows/WG); grid C / 8.
+KERNEL(64) void ink2_down_q8_dp4a(global const char *q, global const half *s, global const int *ids,
+                                  global const float *wts, global const char *aq, global const float *as_,
+                                  global const float *w, global const float *hin, global float *hout, int site,
+                                  global const float *res, global float *out) {
+  const int lane = get_sub_group_local_id(), r = (get_group_id(0) * 4 + get_sub_group_id()) * 2;
+  const int slot = lane >> 1, e = ids[slot];
+  const int ks = FF / 32;
+  global const char *q0 = q + ((long)e * C + r) * FF, *q1 = q0 + FF;
+  global const half *s0 = s + ((long)e * C + r) * ks, *s1 = s0 + ks;
+  global const char *xq = aq + slot * FF;
+  global const float *xs = as_ + slot * ks;
+  float a0 = 0.0f, a1 = 0.0f;
+  for (int b = lane & 1; b < ks; b += 2) {
+    const char16 x0 = vload16(2 * b, xq), x1 = vload16(2 * b + 1, xq);
+    const float sx = xs[b];
+    a0 += (float)dp4a_blk32(vload16(2 * b, q0), vload16(2 * b + 1, q0), x0, x1) * ((float)s0[b] * sx);
+    a1 += (float)dp4a_blk32(vload16(2 * b, q1), vload16(2 * b + 1, q1), x0, x1) * ((float)s1[b] * sx);
+  }
+  const float f = wts[slot];
+  a0 = sub_group_reduce_add(a0 * f);
+  a1 = sub_group_reduce_add(a1 * f);
+  if (lane < 2) {
+    const int rr = r + lane;
+    out[rr] = conv_post(lane ? a1 : a0, w + rr * NCONV, hin, hout, site + rr) + res[rr];
+  }
+}
