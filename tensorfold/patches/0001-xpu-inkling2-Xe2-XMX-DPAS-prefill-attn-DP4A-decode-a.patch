+  const float sk = qok ? D[(long)tok * 88 + kvh * 3 + hq] : 0.0f;
+  const float4 r0 = vload4(0, &rf[lane][0]);
+  const float4 r1 = vload4(0, &rf[lane][4]);
+  const float4 r2 = vload4(0, &rf[lane][8]);
+  const float4 r3 = vload4(0, &rf[lane][12]);
+
+  const int maxpos = p0c + min(t0 + 4, T - 1);
+  const int min_lo = window > 0 ? max(0, (p0c + t0) - window + 1) : 0;
+  const int tile_start = min_lo >> 6;
+  const int tile_end = maxpos >> 6;
+
+  float mrun = 0.0f, lrun = 1.0f; // sink logit 0 -> exp(0) = 1
+  float8 orun0 = (float8)(0.0f), orun1 = (float8)(0.0f);
