+// Xe2 XMX DPAS prompt FlashAttention: 5 tokens x 3 GQA heads/WG, 64-key tiles, sink logit 0; grid (8, (T + 4) / 5).
+KERNEL(128) void ink2_attn_b_xmx(global const float *Q, global const float *R, global const float *D,
+                                 global const half *Kc, global const half *Vc, global const float *relb,
