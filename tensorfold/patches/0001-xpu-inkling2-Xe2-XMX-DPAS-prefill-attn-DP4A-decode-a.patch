+// O projection + post conv + residual via DP4A (2 rows/sg, 64 threads = 8 rows/WG); grid C / 8.
+KERNEL(64) void ink2_gemv_conv2s_dp4a(global const char *q, global const half *s, int K, global const char *xq,
+                                      global const float *xs, global const float *w, global const float *hin,
+                                      global float *hout, int site, global const float *res, int has_res, global float *out) {
+  const int r = (get_group_id(0) * 4 + get_sub_group_id()) * 2;
+  const float2 y = q8_row2_dp4a(q + (long)r * K, q + (long)(r + 1) * K, s + (long)r * (K / 32), s + (long)(r + 1) * (K / 32), K, xq, xs);
+  const int lane = get_sub_group_local_id();
+  if (lane < 2) {
+    const int rr = r + lane;
+    float v = conv_post(lane ? y.y : y.x, w + rr * NCONV, hin, hout, site + rr);
+    if (has_res) v += res[rr];
+    out[rr] = v;
+  }
+}
