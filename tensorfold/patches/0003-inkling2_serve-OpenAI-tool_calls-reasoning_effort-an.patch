Date: Sat, 21 Nov 2026 23:03:13 -0600
Subject: [PATCH 3/5] inkling2_serve: OpenAI tool_calls, reasoning_effort, and
 --host support

Pass tools and reasoning_effort into Inkling-2-Mini chat_template.jinja, canonicalize JSON-string
assistant tool_call arguments, parse <|content_invoke_tool_json|> into OpenAI tool_calls (streaming
and non-streaming), add --host flag (default 127.0.0.1), and accept standard OpenAI top_p fields.
---
 tools/xpu/inkling2_serve.py | 121 ++++++++++++++++++++++++++++++------
 1 file changed, 103 insertions(+), 18 deletions(-)

diff --git a/tools/xpu/inkling2_serve.py b/tools/xpu/inkling2_serve.py
index a3dddc38..49f02079 100644
--- a/tools/xpu/inkling2_serve.py
+++ b/tools/xpu/inkling2_serve.py
@@ -19,6 +19,30 @@ from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
 from transformers import PreTrainedTokenizerFast
 
 MESSAGE_MODEL, CONTENT_TEXT, EOS, CONTENT_THINKING, END_MESSAGE = 200001, 200004, 200006, 200008, 200010
+CONTENT_TOOL_JSON, CONTENT_TOOL_TEXT = 200049, 200057
+
+
+def normalize_messages(messages):
+    """Canonicalize OpenAI messages for Inkling-2-Mini's chat_template.jinja (parse JSON string tool_call arguments)."""
+    out = []
+    for m in messages:
+        if m.get("role") == "assistant" and m.get("tool_calls"):
+            m = dict(m)
+            tcs = []
+            for tc in m["tool_calls"]:
+                tc = dict(tc)
+                fn = dict(tc.get("function") or {})
+                args = fn.get("arguments")
+                if isinstance(args, str):
+                    try:
+                        fn["arguments"] = json.loads(args) if args.strip() else {}
+                    except json.JSONDecodeError:
+                        fn["arguments"] = {"_raw": args}
+                tc["function"] = fn
+                tcs.append(tc)
+            m["tool_calls"] = tcs
+        out.append(m)
+    return out
 
 
 class Runner:
@@ -49,24 +73,73 @@ class Runner:
 
 
 class Splitter:
-    """Token ids to reasoning / content text deltas."""
+    """Token ids to reasoning / content text deltas and OpenAI tool_calls."""
 
     def __init__(self, tok):
         self.tok = tok
-        self.mode = "content"
-        self.count = {"content": 0, "reasoning": 0}
+        self.mode = "header"
+        self.count = {"content": 0, "reasoning": 0, "tool": 0}
         self.ids = {"content": [], "reasoning": []}
         self.text = {"content": "", "reasoning": ""}
+        self.tool_ids = []
+        self.header_ids = []
+        self.tool_calls = []
+
+    def _flush_tool(self):
+        if not self.tool_ids:
+            return None
+        raw = self.tok.decode(self.tool_ids, skip_special_tokens=True).strip()
+        hdr_name = self.tok.decode(self.header_ids, skip_special_tokens=True).strip()
+        self.tool_ids = []
+        self.header_ids = []
+        name, args = hdr_name, {}
+        try:
+            obj = json.loads(raw)
+            if isinstance(obj, dict):
+                name = obj.get("name") or hdr_name
+                args = obj.get("args") if "args" in obj else obj.get("arguments", {})
+        except json.JSONDecodeError:
+            args = {"_raw": raw}
+        idx = len(self.tool_calls)
+        tc = {
+            "id": "call_%012x" % random.getrandbits(48),
+            "type": "function",
+            "function": {
+                "name": name,
+                "arguments": json.dumps(args, separators=(",", ":")) if not isinstance(args, str) else args,
+            },
+        }
+        self.tool_calls.append(tc)
+        return ("tool_call", idx, tc)
 
     def push(self, t):
+        if t == MESSAGE_MODEL:
+            self.mode = "header"
+            self.header_ids = []
+            return None
         if t == CONTENT_THINKING:
             self.mode = "reasoning"
             return None
         if t == CONTENT_TEXT:
             self.mode = "content"
             return None
+        if t in (CONTENT_TOOL_JSON, CONTENT_TOOL_TEXT):
+            self.mode = "tool_json"
+            self.tool_ids = []
+            return None
+        if t in (END_MESSAGE, EOS):
+            ev = self._flush_tool() if self.mode == "tool_json" else None
+            self.mode = "header"
+            return ev
         if t >= 199998:  # other control tokens carry no text
             return None
+        if self.mode == "header":
+            self.header_ids.append(t)
+            return None
+        if self.mode == "tool_json":
+            self.count["tool"] += 1
+            self.tool_ids.append(t)
+            return None
         m = self.mode
         self.count[m] += 1
         self.ids[m].append(t)
